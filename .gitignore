# ---- Flutter / Dart ----
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Flutter build outputs — covers desktop, web, mobile.
build/

# Test coverage output
coverage/

# ---- Platform runner folders we don't target ----
# The PoC targets Windows, Linux, and web. iOS/Android/macOS aren't wired up.
# If you want to add them later, `flutter create --platforms=ios,android,macos .`
# will regenerate the scaffolding and you can untrack these lines.
ios/
android/
macos/

# ---- Flutter platform auto-generated scaffolding ----
# Regenerated by every `flutter build`; no hand-editable content.
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# ---- Web bundle: hand-written vs generated ----
# web/wasm/maze.{js,wasm} are Emscripten outputs produced by
# tools/build_wasm.{sh,ps1}. web/wasm/maze_wrapper.js is hand-written source
# (the JS bridge that exposes window.MazeWasm) and IS tracked.
web/wasm/maze.js
web/wasm/maze.wasm

# ---- Native / CMake build outputs ----
native/build/
server_cpp/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Visual Studio / MSVC artifacts
.vs/
Debug/
Release/
x64/
x86/
*.user
*.suo
*.userprefs
*.VC.db
*.VC.VC.opendb

# Flutter Windows runner build scratch (also covered by build/ above, but be explicit)
windows/.vs/
windows/x64/
windows/Debug/
windows/Release/

# ---- Log files ----
# `*.log` for conventional logs; `*.logs.txt` for the app's own log output
# (tools/run_web.sh and the Windows release binary both write `*.logs.txt`).
*.log
*.logs.txt

# ---- IDE / Editor ----
.idea/
.vscode/
*.iml
.history/

# ---- OS-specific ----
.DS_Store
Thumbs.db